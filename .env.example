# --- Provozní databáze (SQL Server, vlastní databáze a login) ----------
# Login má práva jen v této databázi; do produkčních databází ani do
# Heliosu služba nezapisuje.
DATABASE_URL="sqlserver://SERVER:1433;database=RenoWorkshop;user=renoworkshop;password=;encrypt=true;trustServerCertificate=true"

# --- Helios (jen pro čtení!) ------------------------------------------
# Instance s linkovaným serverem na Helios. Účet musí mít práva pouze
# SELECT nad pohledy v_renoworkshop_*.
# Když je to tatáž instance jako výše, liší se jen databáze a login.
HELIOS_SERVER="SERVER"
HELIOS_DATABASE="RenoWorkshop"
HELIOS_USER="renoworkshop_ro"
HELIOS_PASSWORD=""
# Ověření certifikátu SQL Serveru; ve vnitřní síti bývá self-signed.
HELIOS_TRUST_CERT="true"

# Jak často se tahají zakázky z Heliosu (vteřiny).
SYNC_INTERVAL_SECONDS="300"

# --- Firebase (ověření tokenu z mobilní aplikace) ---------------------
FIREBASE_PROJECT_ID="renoworkshop"
GOOGLE_APPLICATION_CREDENTIALS="./secrets/firebase-service-account.json"

# --- Server -----------------------------------------------------------
PORT="8081"
HOST="0.0.0.0"
