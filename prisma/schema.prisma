// Schéma provozní databáze RenoWorkshopu.
//
// Běží na SQL Serveru RENOCARu, ve vlastní databázi a pod vlastním loginem.
// Do produkčních databází ani do Heliosu služba nezapisuje - z Heliosu jen
// čte přes pohledy `v_renoworkshop_*`.
//
// Záměrně jsou to dvě oddělené skupiny tabulek:
//
//   helios_*   zrcadlo Heliosu. Synchronizace přepisuje jejich obsah, ale
//              **nikdy nic nemaže** - k uzavřeným zakázkám se lidé vracejí
//              kvůli fotodokumentaci. Zatím jen zakázky; úkony (závady)
//              se z Heliosu netahají.
//   dilenske_* naše data, která v Heliosu neexistují. Synchronizace na ně
//              nikdy nesahá, jinak by přišli mechanici o práci.
//
// Spojuje je číslo zakázky (`reference_subjektu` z Heliosu).
//
// Pozor na typy: bez `@db.NVarChar` by texty skončily v `varchar` a diakritika
// by se rozsypala.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Zakázka načtená z Heliosu. Přepisuje se každou synchronizací.
model HeliosZakazka {
  cisloZakazky    String    @id @map("cislo_zakazky") @db.NVarChar(40)
  spz             String?   @db.NVarChar(20)
  vin             String?   @db.NVarChar(30)
  model           String?   @db.NVarChar(200)
  zakaznik        String?   @db.NVarChar(200)
  utvarKod        String?   @map("utvar_kod") @db.NVarChar(20)
  utvarNazev      String?   @map("utvar_nazev") @db.NVarChar(200)

  /// Číslo řady zakázky z Heliosu (`801`). Název se k němu dohledává
  /// v `typy_zakazek`, ne tady - jinak by přejmenování řady vyžadovalo
  /// přepsat všechny zakázky.
  ///
  /// Bez cizího klíče schválně: kdyby v Heliosu vznikla řada, kterou
  /// ještě nikdo do převodní tabulky nedoplnil, cizí klíč by shodil
  /// celou synchronizaci.
  /// Šířka 50: `reference_subjektu` v Heliosu není jen trojčíslí, jak se
  /// zdálo z číselníku - kratší sloupec první synchronizaci shodil (P2000).
  radaReference   String?   @map("rada_reference") @db.NVarChar(50)

  /// Kdo za zakázku v Heliosu zodpovídá. Kód i jméno, stejně jako útvar:
  /// kód je stabilní klíč, jméno se zobrazuje.
  /// Vozidlo a organizace z Heliosu (`cislo_subjektu`). Klíč do zrcadel
  /// `helios_vozidla` a `helios_organizace`, přes který se skládá historie
  /// vozu: naskenuje se SPZ, najde vozidlo a k němu všechny jeho zakázky.
  ///
  /// Bez cizího klíče, ze stejného důvodu jako u `rada_reference`: zakázka
  /// na vozidlo, které se ještě nedotáhlo, nesmí shodit celou synchronizaci.
  ///
  /// `spz`, `vin` a `zakaznik` zůstávají i tady schválně. Není to duplicita,
  /// ale snímek stavu při přijetí - vůz může za dva roky změnit majitele
  /// i značku a stará zakázka má ukazovat, jak to bylo tehdy.
  vozidloId       Int?      @map("vozidlo_id")

  /// `cislo_subjektu` hlavičky zakázky v Heliosu. Stabilní klíč, přes který
  /// se k zakázce napojují závady (`helios_zavady.zakazka`). Číslo zakázky
  /// (`cislo_zakazky`) na to nestačí - v Heliosu se výjimečně opakuje.
  zakazkaId       Int?      @map("zakazka_id")

  /// Pořadač zakázky v Heliosu (`hlv.cislo_poradace`) - v zásadě značka
  /// a pobočka zpracování. Název se dohledává v `poradace`.
  cisloPoradace   Int?      @map("cislo_poradace")

  /// Pojišťovna u pojistné události (`pojistovna1` na hlavičce zakázky) -
  /// `cislo_subjektu` organizace. Název se dohledává v `helios_organizace`,
  /// která drží všechny organizace z Heliosu.
  pojistovnaId    Int?      @map("pojistovna_id")

  /// Číslo pojistné události - uživatelsky definovaný atribut `ino_cpu`
  /// v `uda_ino_srvszak_hlavicka`. Text, pojišťovny ho píší různě.
  cisloPu         String?   @map("cislo_pu") @db.NVarChar(100)
  organizaceId    Int?      @map("organizace_id")

  zodpovidaKod    String?   @map("zodpovida_kod") @db.NVarChar(50)
  zodpovida       String?   @db.NVarChar(200)
  datumPrijeti    DateTime? @map("datum_prijeti") @db.DateTime2
  terminDokonceni DateTime? @map("termin_dokonceni") @db.DateTime2
  stavRealCislo   Int?      @map("stav_real_cislo")
  stavRealNazev   String?   @map("stav_real_nazev") @db.NVarChar(100)

  /// Kdy zakázku naposledy potvrdila synchronizace mezi aktivními.
  videnoAt DateTime @map("videno_at") @db.DateTime2

  /// Stojí vůz na dílně? Uzavřená zakázka se **nikdy nemaže** - drží se
  /// kvůli poznámkám a fotodokumentaci, ke které se lidé vracejí i po roce.
  /// Do seznamu v telefonu se neposílá, dohledá se hledáním.
  jeAktivni Boolean @default(true) @map("je_aktivni")

  /// Kdy zakázka zmizela z aktivních. `null` = pořád na dílně.
  uzavrenaAt DateTime? @map("uzavrena_at") @db.DateTime2

  /// Stání na dílně. Dřív viselo u dílenského stavu, ale se stavem
  /// nesouvisí - vůz stojí na stejném místě napříč celou opravou.
  stani String? @db.NVarChar(60)

  dilenskeZaznamy DilenskyZaznam[]
  poznamky        Poznamka[]
  dilenskeUdaje   DilenskeUdaje?
  fotky           Fotka[]
  prijem          Prijem?

  @@index([utvarKod])
  // Seznam v telefonu se ptá právě takhle: aktivní, seřazené podle termínu.
  @@index([jeAktivni, terminDokonceni])
  // Hledání v archivu podle SPZ nebo VIN.
  @@index([spz])
  @@index([vin])
  // Historie vozu: všechny zakázky jednoho vozidla, od nejnovější.
  @@index([vozidloId, datumPrijeti])
  // Napojení závad.
  @@index([zakazkaId])
  @@map("helios_zakazky")
}

/// Závada (úkon) na zakázce z Heliosu. Zrcadlo `ino_srvszak_zavady`.
///
/// Na zakázku ukazuje přes `cislo_subjektu` hlavičky, ne přes číslo
/// zakázky - to se v Heliosu výjimečně opakuje. Bez cizího klíče: závada
/// k zakázce, která se ještě nedotáhla, nesmí shodit synchronizaci.
///
/// Na rozdíl od ostatních zrcadel se **maže**: závada odebraná v Heliosu
/// z rozdělané zakázky má zmizet i v aplikaci, jinak by dílna opravovala,
/// co už na zakázce není. Dílna k závadám nic nezapisuje, takže se nic
/// neztratí.
model HeliosZavada {
  id Int @id @map("cislo_subjektu")

  /// `cislo_subjektu` hlavičky zakázky - viz `HeliosZakazka.zakazkaId`.
  zakazkaId Int? @map("zakazka")

  reference String? @map("reference_subjektu") @db.NVarChar(50)

  /// Stručný popis závady (`nazev_subjektu`) - podle něj ji dílna pozná.
  nazev     String? @map("nazev_subjektu") @db.NVarChar(255)

  /// Podrobnosti, jak je poradce rozepsal. Může mít víc řádků.
  poznamka  String? @db.NVarChar(Max)

  videnoAt DateTime @map("videno_at") @db.DateTime2

  @@index([zakazkaId])
  @@map("helios_zavady")
}

/// Značka a model z Heliosu. Zrcadlo číselníku `ino_znackamodel`.
///
/// Malá tabulka, která se skoro nemění - tahá se celá v nočním běhu
/// a nikdy se na ni nedoptáváme. Palivo a motor jsou tady, ne u vozidla:
/// v Heliosu je vede model, ne konkrétní kus.
model HeliosModel {
  id Int @id @map("cislo_subjektu")

  reference   String? @map("reference_subjektu") @db.NVarChar(50)
  nazev       String? @map("nazev_subjektu") @db.NVarChar(255)
  serie       String? @db.NVarChar(100)
  nazevDlouhy String? @map("nazev_dlouhy") @db.NVarChar(255)
  palivo      String? @db.NVarChar(100)
  motor       String? @db.NVarChar(255)

  videnoAt DateTime @map("videno_at") @db.DateTime2

  @@map("helios_modely")
}

/// Kontaktní osoba z Heliosu. Zrcadlo tabulky `kontaktni_osoby`.
///
/// Komu se na dílně volá. Visí na vozidle, ne na organizaci - u firemního
/// vozu je to řidič, který s autem přijel, ne někdo z účtárny.
model HeliosKontakt {
  id Int @id @map("cislo_subjektu")

  jmeno    String? @db.NVarChar(255)
  prijmeni String? @db.NVarChar(255)

  uliceDomu String? @map("ulice_domu") @db.NVarChar(255)
  mistoDomu String? @map("misto_domu") @db.NVarChar(255)
  pscDomu   String? @map("psc_domu") @db.NVarChar(20)

  email        String? @db.NVarChar(255)
  telefonMobil String? @map("telefon_mobil") @db.NVarChar(60)

  videnoAt DateTime @map("videno_at") @db.DateTime2

  @@map("helios_kontakty")
}

/// Vozidlo z Heliosu. Zrcadlo tabulky `ino_vozidlo`, celé bez filtru.
///
/// Tohle je vstupní bod vyhledávání: naskenuje se SPZ, najde se vozidlo
/// a od něj se jde na majitele a na všechny jeho zakázky napříč lety.
///
/// Identita vozu je VIN, ne SPZ. SPZ se při přeregistraci mění a stejná
/// značka může časem patřit jinému autu - proto se hledá podle obou
/// a klíčem zůstává `cislo_subjektu` z Heliosu.
model HeliosVozidlo {
  /// `cislo_subjektu` z Heliosu. Klíč, přes který na vozidlo ukazuje
  /// `helios_zakazky.vozidlo_id`.
  id Int @id @map("cislo_subjektu")

  reference String? @map("reference_subjektu") @db.NVarChar(50)
  nazev     String? @map("nazev_subjektu") @db.NVarChar(255)

  spz String? @db.NVarChar(30)

  /// V Heliosu `vyr_cislo_karoserie`.
  vin String? @db.NVarChar(50)

  /// Klíče do dalších zrcadel. Bez cizích klíčů, stejně jako u zakázky:
  /// vozidlo s majitelem, který se ještě nedotáhl, nesmí shodit celou
  /// synchronizaci.
  znackamodelId    Int? @map("znackamodel")
  majitelId        Int? @map("majitel")
  kontaktniOsobaId Int? @map("kontaktni_osoba")

  stavTachometru Int?      @map("stav_tachometru")
  prodejDatum    DateTime? @map("prodej_datum") @db.DateTime2

  videnoAt DateTime @map("videno_at") @db.DateTime2

  // Hledání po naskenování kódu. VIN je spolehlivější, SPZ rychlejší.
  @@index([spz])
  @@index([vin])
  @@map("helios_vozidla")
}

/// Zákazník z Heliosu. Zrcadlo tabulky `organizace`, celé bez filtru.
///
/// Slouží k tomu, aby po naskenování SPZ šlo ukázat majitele vozu, aniž by
/// se appka musela ptát Heliosu. Zakázka si přitom svého zákazníka drží
/// vlastní (sloupec `zakaznik`): tady je stav dnešní, tam stav při přijetí.
///
/// Šířky jsou schválně velkorysejší než v Heliosu. Užší sloupec by při
/// nečekaně dlouhé hodnotě shodil celou synchronizaci (P2000), širší
/// nestojí na SQL Serveru nic - `nvarchar` je proměnné délky.
model HeliosOrganizace {
  /// `cislo_subjektu` z Heliosu. Klíč, přes který na organizaci ukazuje
  /// `helios_zakazky.organizace_id`.
  id Int @id @map("cislo_subjektu")

  /// Číslo zákazníka, kterým ho pojmenují lidé na příjmu.
  reference String? @map("reference_subjektu") @db.NVarChar(50)
  nazev     String? @map("nazev_subjektu") @db.NVarChar(255)

  ico String? @db.NVarChar(20)
  dic String? @db.NVarChar(30)

  ulice   String? @db.NVarChar(255)
  cisloCp String? @map("cislo_cp") @db.NVarChar(20)
  cisloCo String? @map("cislo_co") @db.NVarChar(20)
  misto   String? @db.NVarChar(255)
  psc     String? @db.NVarChar(20)

  /// Druhá adresa z Heliosu (`ulice_ds`).
  uliceDs String? @map("ulice_ds") @db.NVarChar(255)

  telefon String? @db.NVarChar(60)
  email   String? @db.NVarChar(255)

  /// Kdy záznam naposledy potvrdila synchronizace. Nemaže se nic - zákazník
  /// zrušený v Heliosu má zůstat čitelný u svých starých zakázek.
  videnoAt DateTime @map("videno_at") @db.DateTime2

  // Hledání zákazníka podle jména nebo IČO.
  @@index([nazev])
  @@index([ico])
  @@map("helios_organizace")
}

/// Dílenský stav zakázky - to, co v Heliosu není a co posouvají mechanici.
/// Číselník dílenských stavů - co smí uživatel vybrat z nabídky.
///
/// Spravuje se ručně v databázi; na klempírně se sled prací ustálí a pak
/// se do něj sahá výjimečně. Appka si ho stahuje, takže přidání stavu
/// nevyžaduje novou verzi v telefonech.
model DilenskyStavCiselnik {
  /// Krátký klíč, např. `rozpocet`. Drží i po přejmenování názvu.
  kod    String  @id @db.NVarChar(40)
  nazev  String  @db.NVarChar(100)
  /// Pořadí v nabídce. Stejné číslo = řadí se podle názvu.
  poradi Int     @default(0)
  /// Vyřazený stav se přestane nabízet, ale v historii zůstane.
  jeAktivni Boolean @default(true) @map("je_aktivni")

  @@map("dilenske_stavy_ciselnik")
}

/// Historie dílenských stavů zakázky. **Poslední záznam je ten platný.**
///
/// Oprava po bouračce běží týdny a stavy se vracejí (pojišťovna vrátí
/// rozpočet, díl dorazí poškozený), takže jeden přepisovaný sloupec by
/// zahodil to nejcennější - kdy se co stalo a jak dlouho se na co čekalo.
model DilenskyZaznam {
  id           String @id @default(cuid()) @db.NVarChar(30)
  cisloZakazky String @map("cislo_zakazky") @db.NVarChar(40)

  /// Kód z číselníku, nebo `null` u ručně zapsaného stavu („Jiný").
  kod   String? @db.NVarChar(40)

  /// Text stavu tak, jak se má zobrazit. U číselníkového stavu je to jeho
  /// název **v době zápisu**: přejmenování v číselníku nesmí zpětně měnit,
  /// co se na zakázce dělo.
  nazev String  @db.NVarChar(100)

  /// Co k tomu stavu patří - kde vůz stojí, na kterém zvedáku, na co se
  /// čeká. „Připraveno, stání 4" je jiná informace než holé „Připraveno".
  poznamka String? @db.NVarChar(500)

  zadalKdo String?  @map("zadal_kdo") @db.NVarChar(200)
  zadalUid String?  @map("zadal_uid") @db.NVarChar(128)
  zadanoAt DateTime @default(dbgenerated("sysdatetime()")) @map("zadano_at") @db.DateTime2

  zakazka HeliosZakazka @relation(fields: [cisloZakazky], references: [cisloZakazky], onDelete: Cascade)

  // Seznam i detail se ptají na poslední záznam zakázky.
  @@index([cisloZakazky, zadanoAt])
  @@map("dilenske_zaznamy")
}

/// Údaje zakázky, které vede dílna ručně a Helios je nezná.
///
/// Jeden řádek na zakázku, přepisuje se. Na rozdíl od dílenských stavů tu
/// historie cenu nemá: předmět opravy se upřesňuje ("zadní nárazník" →
/// "zadní nárazník + víko kufru") a platí vždycky ten poslední.
///
/// Vlastní tabulka, ne sloupec v `helios_zakazky`: to je zrcadlo Heliosu
/// a na jeho sloupce smí sahat jen synchronizace.
model DilenskeUdaje {
  cisloZakazky String @id @map("cislo_zakazky") @db.NVarChar(40)

  /// Co se na voze opravuje - volný text, jak ho kolegové dosud psali
  /// do Excelu. `null` = zatím nezadáno.
  predmetOpravy String? @map("predmet_opravy") @db.NVarChar(1000)

  upravilKdo String?  @map("upravil_kdo") @db.NVarChar(200)
  upravilUid String?  @map("upravil_uid") @db.NVarChar(128)
  upravenoAt DateTime @default(dbgenerated("sysdatetime()")) @map("upraveno_at") @db.DateTime2

  zakazka HeliosZakazka @relation(fields: [cisloZakazky], references: [cisloZakazky], onDelete: Cascade)

  @@map("dilenske_udaje")
}

/// Fotka ve fotodokumentaci zakázky.
///
/// Soubor leží ve sdílené složce na souborovém serveru (`FOTO_ADRESAR`),
/// tady je jen záznam. `cesta` je relativní vůči `FOTO_ADRESAR`, ať se dá
/// úložiště přestěhovat změnou jedné proměnné.
model Fotka {
  /// Náhodné id - je i v názvu souboru, ať se dá dohledat z obou stran.
  id           String   @id @db.NVarChar(30)
  cisloZakazky String   @map("cislo_zakazky") @db.NVarChar(40)

  /// Klíč kategorie (`exterier`, `poskozeni`...), viz src/domain/fotky.ts.
  kategorie    String   @db.NVarChar(40)
  cesta        String   @db.NVarChar(400)
  velikost     Int

  nahralKdo    String?  @map("nahral_kdo") @db.NVarChar(200)
  nahralUid    String?  @map("nahral_uid") @db.NVarChar(128)
  nahranoAt    DateTime @map("nahrano_at") @db.DateTime2

  zakazka HeliosZakazka @relation(fields: [cisloZakazky], references: [cisloZakazky], onDelete: Cascade)

  @@index([cisloZakazky, nahranoAt])
  @@map("fotky")
}

/// Checklist příjmu vozidla - co má technik při příjmu na voze
/// zkontrolovat. Spravuje se v databázi: nová kontrola se v telefonech
/// objeví sama a hned je povinná.
model PrijemKontrolaCiselnik {
  kod    String @id @db.NVarChar(40)
  nazev  String @db.NVarChar(200)
  /// `kontrola` = zaškrtnout, `datum` = zapsat datum (platnost STK).
  typ    String @default("kontrola") @db.NVarChar(20)
  poradi Int    @default(0)
  /// Vyřazená kontrola se přestane nabízet a vyžadovat, u hotových
  /// příjmů zůstane.
  jeAktivni Boolean @default(true) @map("je_aktivni")

  @@map("prijem_kontroly_ciselnik")
}

/// Příjem vozidla k zakázce. Jeden na zakázku; vzniká první vyplněnou
/// položkou checklistu.
model Prijem {
  cisloZakazky String    @id @map("cislo_zakazky") @db.NVarChar(40)
  zahajilKdo   String?   @map("zahajil_kdo") @db.NVarChar(200)
  zahajilUid   String?   @map("zahajil_uid") @db.NVarChar(128)
  zahajenoAt   DateTime  @default(dbgenerated("sysdatetime()")) @map("zahajeno_at") @db.DateTime2
  /// `null` = rozpracovaný. Dokončit jde jen s vyplněným checklistem.
  dokoncilKdo  String?   @map("dokoncil_kdo") @db.NVarChar(200)
  dokoncilUid  String?   @map("dokoncil_uid") @db.NVarChar(128)
  dokoncenoAt  DateTime? @map("dokonceno_at") @db.DateTime2

  zakazka HeliosZakazka   @relation(fields: [cisloZakazky], references: [cisloZakazky], onDelete: Cascade)
  polozky PrijemPolozka[]

  @@map("prijmy")
}

/// Vyplněná položka checklistu. Název a typ v době vyplnění -
/// přejmenování v číselníku nemění, co technik při příjmu potvrdil.
model PrijemPolozka {
  cisloZakazky String   @map("cislo_zakazky") @db.NVarChar(40)
  kod          String   @db.NVarChar(40)
  nazev        String   @db.NVarChar(200)
  typ          String   @db.NVarChar(20)
  splneno      Boolean  @default(false)
  /// U typu `datum` datum ve tvaru RRRR-MM-DD.
  hodnota      String?  @db.NVarChar(40)
  /// Co technik při kontrole našel („prasklina v rohu skla").
  poznamka     String?  @db.NVarChar(500)
  zmenilKdo    String?  @map("zmenil_kdo") @db.NVarChar(200)
  zmenilUid    String?  @map("zmenil_uid") @db.NVarChar(128)
  zmenenoAt    DateTime @default(dbgenerated("sysdatetime()")) @map("zmeneno_at") @db.DateTime2

  prijem Prijem @relation(fields: [cisloZakazky], references: [cisloZakazky], onDelete: Cascade)

  @@id([cisloZakazky, kod])
  @@map("prijem_polozky")
}

/// Poznámka mechanika nebo poradce.
model Poznamka {
  id           String   @id @default(uuid()) @db.NVarChar(40)
  cisloZakazky String   @map("cislo_zakazky") @db.NVarChar(40)
  text         String   @db.NVarChar(Max)
  autor        String   @db.NVarChar(200)
  autorUid     String?  @map("autor_uid") @db.NVarChar(128)
  vytvorenoAt  DateTime @default(dbgenerated("sysdatetime()")) @map("vytvoreno_at") @db.DateTime2

  zakazka HeliosZakazka @relation(fields: [cisloZakazky], references: [cisloZakazky], onDelete: Cascade)

  @@index([cisloZakazky, vytvorenoAt])
  @@map("poznamky")
}

/// Log přístupů do služby - kdo, kdy, co a jak to dopadlo. Kvůli
/// bezpečnosti a dohledání chyb; obsah požadavků se neukládá. Starší než
/// LOG_UCHOVANI_DNI se v noci maže. Viz src/domain/log-pristupu.ts.
model ZaznamPristupu {
  id        BigInt   @id @default(autoincrement())
  /// Místní čas serveru - vyplní databáze.
  cas       DateTime @default(dbgenerated("sysdatetime()")) @db.DateTime2
  email     String?  @db.NVarChar(200)
  uid       String?  @db.NVarChar(128)
  ip        String?  @db.NVarChar(64)
  metoda    String   @db.NVarChar(10)
  cesta     String   @db.NVarChar(200)
  zakazka   String?  @db.NVarChar(40)
  parametry String?  @db.NVarChar(200)
  stav      Int
  trvaniMs  Int      @map("trvani_ms")
  chyba     String?  @db.NVarChar(2000)

  @@index([cas])
  @@index([email, cas])
  @@index([zakazka, cas])
  @@map("log_pristupu")
}

/// Záznam o průběhu synchronizace - ať jde poznat, že Helios mlčí,
/// dřív než se na to někdo zeptá.
model Synchronizace {
  id           Int       @id @default(autoincrement())
  zacatekAt    DateTime  @map("zacatek_at") @db.DateTime2
  konecAt      DateTime? @map("konec_at") @db.DateTime2
  pocetZakazek Int?      @map("pocet_zakazek")
  chyba        String?   @db.NVarChar(Max)

  @@map("synchronizace")
}

/// Názvy pořadačů zakázek pro aplikaci. Plní se ručně - pořadačů je pár
/// a názvy z Heliosu („SeZ 2 zpracování zakázky BMW BSL") se do filtru
/// nevejdou. Úprava názvu se v telefonech projeví hned.
model Poradac {
  /// Číslo pořadače z Heliosu, např. `10026`.
  cisloPoradace Int    @id @map("cislo_poradace")

  /// Krátký název pro appku, např. `BMW BSL`.
  nazev         String @db.NVarChar(100)

  /// Složka pobočky ve fotodokumentaci (`Brno`, `Cestlice`...). `null` =
  /// fotky zakázek z tohoto pořadače jdou do složky `Nezarazeno`.
  slozka        String? @db.NVarChar(50)

  @@map("poradace")
}

/// Názvy řad zakázek. Plní se ručně podle číselníku v Heliosu - je jich
/// pár a mění se výjimečně. Úprava názvu se v telefonech projeví hned,
/// bez nasazování a bez nové verze aplikace.
model TypZakazky {
  /// Číslo řady z Heliosu (`rada.reference_subjektu`), např. `801`.
  radaReference String @id @map("rada_reference") @db.NVarChar(20)

  /// Krátký název pro appku, např. `Běžná`. Dlouhý text se na kartu
  /// zakázky nevejde a ořízne se třemi tečkami.
  radaZakazek   String @map("rada_zakazek") @db.NVarChar(100)

  @@map("typy_zakazek")
}
