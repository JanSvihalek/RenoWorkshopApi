# --- Databáze RenoWorkshop na RENDCAPPu --------------------------------
# Jedno připojení pro všechno: vlastní tabulky i pohledy nad Heliosem,
# které přes linkovaný server sahají do DMS.
# Login má práva jen v této databázi.
DATABASE_URL="sqlserver://RENDCAPP:1433;database=RenoWorkshop;user=renoworkshop;password=;encrypt=true;trustServerCertificate=true"

# Jak často se tahají zakázky z Heliosu (vteřiny).
SYNC_INTERVAL_SECONDS="300"

# --- Firebase (ověření tokenu z mobilní aplikace) ---------------------
FIREBASE_PROJECT_ID="renoworkshop"
GOOGLE_APPLICATION_CREDENTIALS="./secrets/firebase-service-account.json"

# --- Server -----------------------------------------------------------
PORT="8081"
HOST="0.0.0.0"
