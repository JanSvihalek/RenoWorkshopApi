# --- Provozní databáze (Postgres v Dockeru na RENDCAPP) ---------------
DATABASE_URL="postgresql://renoworkshop:heslo@localhost:5433/renoworkshop"

# --- Helios (jen pro čtení!) ------------------------------------------
# Připojuje se na lokální SQL Server, který má linkovaný server na Helios.
# Účet musí mít práva pouze SELECT nad pohledy v_renoworkshop_*.
HELIOS_SERVER="RENDCAPP\SQLEXPRESS"
HELIOS_DATABASE="RenoWorkshop"
HELIOS_USER="renoworkshop_ro"
HELIOS_PASSWORD=""
# Ověření certifikátu SQL Serveru; ve vnitřní síti bývá self-signed.
HELIOS_TRUST_CERT="true"

# Jak často se tahají zakázky z Heliosu (vteřiny).
SYNC_INTERVAL_SECONDS="300"

# --- Firebase (ověření tokenu z mobilní aplikace) ---------------------
FIREBASE_PROJECT_ID="renoworkshop"
# Cesta k service account klíči, nebo GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS="./secrets/firebase-service-account.json"

# --- Server -----------------------------------------------------------
PORT="8081"
HOST="0.0.0.0"
